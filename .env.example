# Copy this file to .env or .env.local and fill in your values.
# .env.local takes precedence over .env (useful for per-developer overrides).
# Neither .env nor .env.local should be committed to source control.

TNZ_AUTH_TOKEN=your_auth_token_here

# Optional: override the API base URL (e.g. to point at a staging environment)
# Defaults to https://api.tnz.co.nz/api/v3.00 if not set.
# TNZ_API_URL=https://api.tnz.co.nz/api/v3.00