# Copy this file to .env or .env.local and fill in your values.
# .env.local takes precedence over .env (useful for per-developer overrides).
# Neither .env nor .env.local should be committed to source control.

TNZ_AUTH_TOKEN=your_auth_token_here

# Optional: override the API base URL (e.g. to point at a staging environment)
# Defaults to https://api.tnz.co.nz/api/v3.00 if not set. Must be https:// —
# see TNZ_ALLOW_INSECURE_HTTP below if you genuinely need plain http://.
# TNZ_API_URL=https://api.tnz.co.nz/api/v3.00

# Optional, local development only — bypasses TLS certificate verification for
# a local API server with a self-signed cert. Never set this outside local
# development: it disables MITM protection while still sending your real
# bearer token, and it hard-fails if NODE_ENV=production.
# TNZ_UNSAFE_IGNORE_SSL=true

# Optional, local development only — allows TNZ_API_URL to use plain http://
# instead of https://. Never set this outside local development.
# TNZ_ALLOW_INSECURE_HTTP=true