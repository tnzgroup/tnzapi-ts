# .env.test.example
#
# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real credentials or IDs.
#
# Loading order (later files win):
#   .env → .env.local → .env.test
#
# .env.test is loaded last, so it can override .env.local for integration tests.
# Useful when your integration tests run against a different account or environment
# than your normal local development setup.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Bearer token for TNZ API v3.00
TNZ_AUTH_TOKEN=your_auth_token_here

# Optional: override the API base URL (e.g. point to a staging environment)
# TNZ_API_URL=https://api.tnz.co.nz/api/v3.00

# Optional: point at a local dev API server instead. Use https:// with a
# self-signed cert plus TNZ_UNSAFE_IGNORE_SSL=true (never set that outside
# local development — see README.md's Environment Variables section).
# TNZ_API_URL=https://localhost:5001/api/v3.00
# TNZ_UNSAFE_IGNORE_SSL=true

# ---------------------------------------------------------------------------
# Messaging — recipient fixtures
# Real numbers/addresses used by integration tests that actually send messages.
# Keep these to accounts/numbers you own or have permission to test with.
# ---------------------------------------------------------------------------

# Mobile number for SMS / TTS / Voice / WhatsApp tests (E.164 format)
TNZ_TEST_MOBILE=+64211111111

# Fax number for Fax tests (E.164 format)
TNZ_TEST_FAX=+6491111111

# Email address for Email tests
TNZ_TEST_EMAIL=test@example.com

# Workflow template UUID for Workflow tests
TNZ_TEST_WORKFLOW_TEMPLATE_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Reports / Actions — message fixture
# A real MessageID that exists in your account (already sent).
# Used by Reports.Status, Reports.SMSReply, Actions.Abort, etc.
# ---------------------------------------------------------------------------

TNZ_TEST_MESSAGE_ID=ID123456

# Channel the above MessageID belongs to (sms | email | fax | tts | voice)
TNZ_TEST_MESSAGE_CHANNEL=sms

# ---------------------------------------------------------------------------
# Addressbook — contact fixture
# A real ContactID that exists in your account.
# Used by Addressbook.Contact.Detail / Update / Delete tests.
# ---------------------------------------------------------------------------

TNZ_TEST_CONTACT_ID=00000000-0000-0000-0000-000000000000

# A real GroupID that exists in your account.
TNZ_TEST_GROUP_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Optout — recipient fixture
# A real phone number or email already in your optout list,
# used by Optout.Detail / Delete tests.
# ---------------------------------------------------------------------------

TNZ_TEST_OPTOUT_RECIPIENT=+64211111111